{
  "name": "process-discovery-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the Process Discovery Assistant SaaS module.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/e2e-contract.mjs",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}\""
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
