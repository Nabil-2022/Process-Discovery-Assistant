NODE_ENV=production
PORT=3000

APP_URL=https://process.higroup.systems
API_URL=/api/v1
FRONTEND_URL=https://process.higroup.systems
CORS_ORIGIN=https://process.higroup.systems

DATABASE_URL=postgresql://process_discovery:process_discovery@postgres:5432/process_discovery_local?schema=process_discovery
DIRECT_DATABASE_URL=postgresql://process_discovery:process_discovery@postgres:5432/process_discovery_local?schema=process_discovery

JWT_ACCESS_SECRET=demo_access_secret_change_me_32_chars_min
JWT_REFRESH_SECRET=demo_refresh_secret_change_me_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

COOKIE_DOMAIN=process.higroup.systems
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
ENABLE_SWAGGER=false

AI_PROVIDER=mock
AI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=processdiscovery
STORAGE_SECRET_KEY=processdiscovery
STORAGE_BUCKET=process-discovery-local

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_RESET_EXPIRES_IN=30m
INVITATION_EXPIRES_IN=7d
SUPPORT_ACCESS_MAX_DAYS=14
LOCAL_AUTH_BYPASS=false

SEED_SUPER_ADMIN_EMAIL=super.admin@example.test
SEED_SUPER_ADMIN_PASSWORD=ChangeMe12345!
SEED_MAP_TENANT_ADMIN_EMAIL=tenant.admin@example.test
SEED_MAP_TENANT_ADMIN_PASSWORD=ChangeMe12345!
