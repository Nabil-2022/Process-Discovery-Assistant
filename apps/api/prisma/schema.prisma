  @@unique([tenantId, bucket, objectKey])
  @@index([tenantId, processId])
  @@map("attachments")
  @@schema("process_discovery")
}

model AiGeneration {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  provider   String
  purpose    String
  model      String?
  promptHash String?  @map("prompt_hash")
  inputRef   Json?    @map("input_ref")
  output     Json?
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  suggestions AiSuggestion[]

  @@index([tenantId, purpose, createdAt])
  @@map("ai_generations")
  @@schema("process_discovery")
}

model AiSuggestion {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  processId      String?            @map("process_id") @db.Uuid
  generationId   String?            @map("generation_id") @db.Uuid
  suggestionType String             @map("suggestion_type")
  content        Json
  status         AiSuggestionStatus @default(PROPOSED)
  decidedBy      String?            @map("decided_by") @db.Uuid
  decidedAt      DateTime?          @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  process    Process?      @relation(fields: [processId], references: [id], onDelete: Cascade)
  generation AiGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([tenantId, processId, status])
  @@map("ai_suggestions")
  @@schema("process_discovery")
}

model Notification {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String?            @map("tenant_id") @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  recipientMembershipId String?            @map("recipient_membership_id") @db.Uuid
  type                  NotificationType
  title                 String
  body                  String?
  severity              String             @default("info")
  status                NotificationStatus @default(UNREAD)
  actionUrl             String?            @map("action_url")
  resourceType          String?            @map("resource_type")
  resourceId            String?            @map("resource_id") @db.Uuid
  metadata              Json?
  readAt                DateTime?          @map("read_at") @db.Timestamptz(6)
  expiresAt             DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@index([tenantId, resourceType, resourceId])
  @@map("notifications")
  @@schema("process_discovery")
}

model NotificationPreference {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String?          @map("tenant_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  channel         String
  type            NotificationType
  enabled         Boolean          @default(true)
  frequency       String           @default("immediate")
  language        String           @default("fr")
  quietHoursStart String?          @map("quiet_hours_start")
  quietHoursEnd   String?          @map("quiet_hours_end")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, channel, type])
  @@map("notification_preferences")
  @@schema("process_discovery")
}

model TaskItem {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  assignedToUserId       String?          @map("assigned_to_user_id") @db.Uuid
  assignedToMembershipId String?          @map("assigned_to_membership_id") @db.Uuid
  createdBy              String?          @map("created_by") @db.Uuid
  title                  String
  description            String?
  status                 TaskItemStatus   @default(OPEN)
  priority               TaskItemPriority @default(MEDIUM)
  dueDate                DateTime?        @map("due_date") @db.Timestamptz(6)
  directionId            String?          @map("direction_id") @db.Uuid
  processId              String?          @map("process_id") @db.Uuid
  resourceType           String?          @map("resource_type")
  resourceId             String?          @map("resource_id") @db.Uuid
  actionUrl              String?          @map("action_url")
  completedAt            DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, assignedToUserId, status])
  @@index([tenantId, directionId])
  @@index([tenantId, processId])
  @@map("task_items")
  @@schema("process_discovery")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  supportGrantId String?  @map("support_grant_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id") @db.Uuid
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  correlationId  String?  @map("correlation_id")
  result         String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@map("audit_logs")
  @@schema("process_discovery")
}

model ExportJob {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  processId       String?         @map("process_id") @db.Uuid
  directionId     String?         @map("direction_id") @db.Uuid
  requestedBy     String?         @map("requested_by") @db.Uuid
  exportType      String          @map("export_type")
  format          ExportFormat
  status          ExportJobStatus @default(PENDING)
  parameters      Json?
  storageProvider String?         @map("storage_provider")
  bucket          String?
  objectKey       String?         @map("object_key")
  fileName        String?         @map("file_name")
  mimeType        String?         @map("mime_type")
  size            BigInt?
  checksum        String?
  errorMessage    String?         @map("error_message")
  metadata        Json?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)
  failedAt        DateTime?       @map("failed_at") @db.Timestamptz(6)
  expiresAt       DateTime?       @map("expires_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  process Process? @relation(fields: [processId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, processId])
  @@map("export_jobs")
  @@schema("process_discovery")
}
