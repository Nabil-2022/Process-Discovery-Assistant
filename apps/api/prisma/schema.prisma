generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["process_discovery"]
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@schema("process_discovery")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED

  @@schema("process_discovery")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED

  @@schema("process_discovery")
}

enum ProcessStatus {
  DRAFT
  IN_PROGRESS
  READY_FOR_REVIEW
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  PUBLISHED
  ARCHIVED

  @@schema("process_discovery")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED

  @@schema("process_discovery")
}

enum ValidationDecision {
  SUBMITTED
  REVIEW_STARTED
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  PUBLISHED
  ARCHIVED
  CANCELLED

  @@schema("process_discovery")
}

enum AiSuggestionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  MODIFIED
  VALIDATED
  ARCHIVED

  @@schema("process_discovery")
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED

  @@schema("process_discovery")
}

enum ExportFormat {
  PDF
  DOCX
  XLSX
  JSON
  BPMN_XML
  ZIP
  CSV

  @@schema("process_discovery")
}

enum NotificationType {
  INVITATION
  ASSIGNMENT
  PROCESS_INCOMPLETE
  PROCESS_READY
  SUBMISSION
  CHANGES_REQUESTED
  RESUBMISSION
  VALIDATION
  PUBLICATION
  EXPORT_READY
  CAMPAIGN_LATE
  AI_SUGGESTION_AVAILABLE
  INVITATION_RECEIVED
  DIRECTION_ASSIGNED
  REFERENT_REMINDED
  PROCESS_READY_FOR_REVIEW
  PROCESS_SUBMITTED
  REVIEW_STARTED
  PROCESS_RESUBMITTED
  PROCESS_APPROVED
  PROCESS_PUBLISHED
  PROCEDURE_PUBLISHED
  EXPORT_COMPLETED
  EXPORT_FAILED
  COMMENT_CREATED
  MENTION_CREATED
  MOROCCO_COMPLIANCE_ALERT
  QUALITY_BLOCKING_ISSUE
  DEADLINE_APPROACHING

  @@schema("process_discovery")
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED

  @@schema("process_discovery")
}

enum TaskItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("process_discovery")
}

enum TaskItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("process_discovery")
}

enum RaciRole {
  RESPONSIBLE
  ACCOUNTABLE
  CONSULTED
  INFORMED

  @@schema("process_discovery")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("process_discovery")
}

enum RiskStatus {
  IDENTIFIED
  ASSESSED
  TREATMENT_PLANNED
  MONITORED
  CLOSED

  @@schema("process_discovery")
}

enum KpiStatus {
  DRAFT
  PROPOSED
  VALIDATED
  ARCHIVED

  @@schema("process_discovery")
}

enum DocumentStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  EFFECTIVE
  SUPERSEDED
  ARCHIVED

  @@schema("process_discovery")
}

enum SupportAccessStatus {
  REQUESTED
  APPROVED
  ACTIVE
  REVOKED
  EXPIRED
  REJECTED

  @@schema("process_discovery")
}

enum SnapshotType {
  WORKING
  SUBMITTED
  APPROVED
  PUBLISHED
  RESTORED_SOURCE

  @@schema("process_discovery")
}

enum AuthActionTokenType {
  INVITATION
  PASSWORD_RESET

  @@schema("process_discovery")
}

model Tenant {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  slug           String       @unique
  status         TenantStatus @default(ACTIVE)
  deploymentMode String?      @map("deployment_mode")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  lockVersion    Int          @default(1) @map("lock_version")

  settings                TenantSetting[]
  subscriptions           Subscription[]
  tenantFeatures          TenantFeature[]
  memberships             TenantMembership[]
  supportAccessGrants     SupportAccessGrant[]
  tenantTemplates         TenantTemplate[]
  directions              Direction[]
  campaigns               Campaign[]
  campaignDirections      CampaignDirection[]
  processCategories       ProcessCategory[]
  processes               Process[]
  processInputs           ProcessInput[]
  processOutputs          ProcessOutput[]
  processActivities       ProcessActivity[]
  processTransitions      ProcessTransition[]
  actors                  Actor[]
  processActorRoles       ProcessActorRole[]
  applications            Application[]
  processApplications     ProcessApplication[]
  documents               Document[]
  processDocuments        ProcessDocument[]
  kpis                    Kpi[]
  risks                   Risk[]
  controls                Control[]
  riskControls            RiskControl[]
  painPoints              PainPoint[]
  automationNeeds         AutomationNeed[]
  completenessAssessments CompletenessAssessment[]
  raciAssessments         RaciAssessment[]
  raciVersions            RaciVersion[]
  bpmnModels              BpmnModel[]
  bpmnVersions            BpmnVersion[]
  processVersions         ProcessVersion[]
  processSnapshots        ProcessSnapshot[]
  processValidations      ProcessValidation[]
  comments                Comment[]
  procedureDocuments      ProcedureDocument[]
  procedureSections       ProcedureSection[]
  procedureVersions       ProcedureVersion[]
  procedureApprovals      ProcedureApproval[]
  attachments             Attachment[]
  aiGenerations           AiGeneration[]
  aiSuggestions           AiSuggestion[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]
  exportJobs              ExportJob[]
  authActionTokens        AuthActionToken[]
  moroccoCompliances      MoroccoProcessCompliance[]
  eventLogImports         EventLogImport[]
  eventLogCases           EventLogCase[]
  eventLogEvents          EventLogEvent[]
  eventLogAttributes      EventLogAttribute[]
  processMiningRuns       ProcessMiningRun[]
  discoveredModels        DiscoveredModel[]
  conformanceChecks       ConformanceCheck[]
  bottleneckAnalyses      BottleneckAnalysis[]
  bpmnExports             BpmnExport[]
  taskItems               TaskItem[]

  @@index([status])
  @@map("tenants")
  @@schema("process_discovery")
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_settings")
  @@schema("process_discovery")
}

model Subscription {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  plan      String
  status    String
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("subscriptions")
  @@schema("process_discovery")
}

model Feature {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenantFeatures TenantFeature[]

  @@map("features")
  @@schema("process_discovery")
}

model TenantFeature {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  featureId String   @map("feature_id") @db.Uuid
  enabled   Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@unique([tenantId, featureId])
  @@index([tenantId, enabled])
  @@map("tenant_features")
  @@schema("process_discovery")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String?    @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(INVITED)
  locale       String     @default("fr")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  lockVersion  Int        @default(1) @map("lock_version")

  memberships      TenantMembership[]
  userRoles        UserRole[]
  sessions         Session[]
  refreshTokens    RefreshToken[]
  authActionTokens AuthActionToken[]
  auditLogs        AuditLog[]         @relation("AuditActor")

  @@index([status])
  @@map("users")
  @@schema("process_discovery")
}

model TenantMembership {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      MembershipStatus @default(INVITED)
  invitedBy   String?          @map("invited_by") @db.Uuid
  invitedAt   DateTime?        @map("invited_at") @db.Timestamptz(6)
  joinedAt    DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  lockVersion Int              @default(1) @map("lock_version")

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles            MembershipRole[]
  directions       MembershipDirection[]
  authActionTokens AuthActionToken[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("tenant_memberships")
  @@schema("process_discovery")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, expiresAt])
  @@map("sessions")
  @@schema("process_discovery")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  tokenHash         String    @map("token_hash")
  familyId          String    @map("family_id") @db.Uuid
  rotatedFromId     String?   @map("rotated_from_id") @db.Uuid
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  usedAt            DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  createdIp         String?   @map("created_ip")
  lastUsedIp        String?   @map("last_used_ip")
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([familyId])
  @@index([userId, expiresAt])
  @@index([sessionId])
  @@map("refresh_tokens")
  @@schema("process_discovery")
}

model AuthActionToken {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String?             @map("tenant_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  membershipId String?             @map("membership_id") @db.Uuid
  tokenHash    String              @map("token_hash")
  type         AuthActionTokenType
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime?           @map("used_at") @db.Timestamptz(6)
  createdIp    String?             @map("created_ip")
  userAgent    String?             @map("user_agent")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership TenantMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([tenantId, type, expiresAt])
  @@index([userId, type, expiresAt])
  @@map("auth_action_tokens")
  @@schema("process_discovery")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  memberships MembershipRole[]
  users       UserRole[]

  @@map("roles")
  @@schema("process_discovery")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([resource, action])
  @@map("permissions")
  @@schema("process_discovery")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("process_discovery")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
  @@schema("process_discovery")
}

model MembershipRole {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@map("membership_roles")
  @@schema("process_discovery")
}

model MembershipDirection {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  directionId  String @map("direction_id") @db.Uuid

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  direction  Direction        @relation(fields: [directionId], references: [id], onDelete: Cascade)

  @@unique([membershipId, directionId])
  @@index([directionId])
  @@map("membership_directions")
  @@schema("process_discovery")
}

model SupportAccessGrant {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  supportUserId    String              @map("support_user_id") @db.Uuid
  authorizedById   String?             @map("authorized_by_id") @db.Uuid
  createdById      String?             @map("created_by_id") @db.Uuid
  revokedById      String?             @map("revoked_by_id") @db.Uuid
  revocationReason String?             @map("revocation_reason")
  status           SupportAccessStatus @default(REQUESTED)
  reason           String
  scope            Json
  permissions      Json
  validFrom        DateTime            @map("valid_from") @db.Timestamptz(6)
  expiresAt        DateTime            @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?           @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, expiresAt])
  @@index([supportUserId, status])
  @@map("support_access_grants")
  @@schema("process_discovery")
}

model Template {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions TemplateVersion[]

  @@map("templates")
  @@schema("process_discovery")
}

model TemplateVersion {
  id            String   @id @default(uuid()) @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  versionNumber Int      @map("version_number")
  status        String   @default("draft")
  configuration Json
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template        Template            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  directions      TemplateDirection[]
  fields          TemplateField[]
  rules           TemplateRule[]
  tenantTemplates TenantTemplate[]

  @@unique([templateId, versionNumber])
  @@index([templateId, status])
  @@map("template_versions")
  @@schema("process_discovery")
}

model TemplateDirection {
  id                String  @id @default(uuid()) @db.Uuid
  templateVersionId String  @map("template_version_id") @db.Uuid
  name              String
  code              String?
  sortOrder         Int     @default(0) @map("sort_order")
  metadata          Json?

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, name])
  @@index([templateVersionId, sortOrder])
  @@map("template_directions")
  @@schema("process_discovery")
}

model TemplateField {
  id                String  @id @default(uuid()) @db.Uuid
  templateVersionId String  @map("template_version_id") @db.Uuid
  stepCode          String  @map("step_code")
  fieldKey          String  @map("field_key")
  label             String
  fieldType         String  @map("field_type")
  required          Boolean @default(false)
  validation        Json?
  helpText          String? @map("help_text")
  examples          Json?
  sortOrder         Int     @default(0) @map("sort_order")

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, fieldKey])
  @@index([templateVersionId, stepCode, sortOrder])
  @@map("template_fields")
  @@schema("process_discovery")
}

model TemplateRule {
  id                String  @id @default(uuid()) @db.Uuid
  templateVersionId String  @map("template_version_id") @db.Uuid
  ruleType          String  @map("rule_type")
  code              String
  configuration     Json
  severity          String?

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, code])
  @@index([templateVersionId, ruleType])
  @@map("template_rules")
  @@schema("process_discovery")
}

model TenantTemplate {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  templateVersionId String   @map("template_version_id") @db.Uuid
  appliedBy         String?  @map("applied_by") @db.Uuid
  appliedAt         DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  frozenConfig      Json     @map("frozen_config")
  customizations    Json?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, templateVersionId])
  @@index([tenantId, appliedAt])
  @@map("tenant_templates")
  @@schema("process_discovery")
}

model Direction {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  code        String?
  parentId    String?   @map("parent_id") @db.Uuid
  status      String    @default("active")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  lockVersion Int       @default(1) @map("lock_version")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membershipDirections MembershipDirection[]
  campaignDirections   CampaignDirection[]
  processes            Process[]
  actors               Actor[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("directions")
  @@schema("process_discovery")
}

model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  startsAt    DateTime?      @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime?      @map("ends_at") @db.Timestamptz(6)
  createdBy   String?        @map("created_by") @db.Uuid
  updatedBy   String?        @map("updated_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  lockVersion Int            @default(1) @map("lock_version")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  directions CampaignDirection[]
  processes  Process[]

  @@index([tenantId, status])
  @@map("campaigns")
  @@schema("process_discovery")
}

model CampaignDirection {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  campaignId  String  @map("campaign_id") @db.Uuid
  directionId String  @map("direction_id") @db.Uuid
  status      String  @default("active")
  progress    Decimal @default(0) @db.Decimal(5, 2)

